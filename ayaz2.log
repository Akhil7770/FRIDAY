JOIN
  `anbc-hcb-dev.prv_ps_ce_dec_hcb_dev.CET_RATES` r
ON
    (r.PRODUCT_CD = p.PRODUCT_CD OR r.PRODUCT_CD = 'ALL')
    AND p.PROVIDER_BUSINESS_GROUP_NBR = r.PROVIDER_BUSINESS_GROUP_NBR
WHERE
  p.PROVIDER_IDENTIFICATION_NBR = 6608370
  AND p.TAX_IDENTIFICATION_NBR = 'EQyoUK3x}'
  AND p.NETWORK_ID = '00606'
  AND p.SERVICE_LOCATION_NBR = 9763020
  AND (p.PROVIDER_TYPE_CD = 'DC' OR TRIM(p.SPECIALTY_CD) = '')
  AND r.PLACE_OF_SERVICE_CD = '11'
  AND r.SERVICE_CD = '98941'
  AND r.SERVICE_TYPE_CD = 'CPT4'
  AND r.CONTRACT_TYPE = 'D'
)
SELECT
  rate as max_rate,
  payment_method_cd
FROM RankedRates
WHERE rn = 1
;

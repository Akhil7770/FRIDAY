  AND p.TAX_IDENTIFICATION_NBR = '++2wuX/Dl'
  AND p.NETWORK_ID = '00447'
  AND p.SERVICE_LOCATION_NBR = 8926878
  AND (p.PROVIDER_TYPE_CD = 'AP' OR TRIM(p.SPECIALTY_CD) = '')
  AND r.PLACE_OF_SERVICE_CD = '11'
  AND r.SERVICE_CD = '97810'
  AND r.SERVICE_TYPE_CD = 'CPT4'
  AND r.CONTRACT_TYPE IN ('C', 'N')
)
SELECT
  rate as max_rate,
  payment_method_cd
FROM RankedRates
WHERE rn = 1
;

2025-08-11 15:06:16.581 INFO RUNNING RATE QUERY
2025-08-11 15:06:16.581 INFO 
-- NONSTANDARD COMPLEX
WITH RankedRates AS (
SELECT
   r.rate,
   r.PAYMENT_METHOD_CD AS payment_method_cd,
   ROW_NUMBER() OVER (ORDER BY r.rate DESC) as rn
FROM
  `anbc-hcb-dev.prv_ps_ce_dec_hcb_dev.CET_PROVIDERS` p
JOIN
  `anbc-hcb-dev.prv_ps_ce_dec_hcb_dev.CET_RATES` r
ON
    (r.PRODUCT_CD = p.PRODUCT_CD OR r.PRODUCT_CD = 'ALL')
    AND p.PROVIDER_BUSINESS_GROUP_NBR = r.PROVIDER_BUSINESS_GROUP_NBR
WHERE
  p.PROVIDER_IDENTIFICATION_NBR = 9895605
  AND p.TAX_IDENTIFICATION_NBR = '{VNDFV)sg'
  AND p.NETWORK_ID = '01344'
  AND p.SERVICE_LOCATION_NBR = 2257285
  AND (p.PROVIDER_TYPE_CD = 'PH' OR TRIM(p.SPECIALTY_CD) = '30103')
  AND r.PLACE_OF_SERVICE_CD = '11'
  AND r.SERVICE_CD = '97124'
  AND r.SERVICE_TYPE_CD = 'CPT4'
  AND r.CONTRACT_TYPE IN ('C', 'N')
)
SELECT
  rate as max_rate,
  payment_method_cd
FROM RankedRates
WHERE rn = 1
;

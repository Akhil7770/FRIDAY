    q.CONTRACT_TERM_DT,
    q.QUALIFIER_ID,
    l.STRUCTURED_STATEMENT_ID,
    pos.MEMBER_PLACE_OF_SERVICE_CD AS PLACE_OF_SERVICE_CD,
    g.PRODUCT_CD
FROM
    `edp-prod-hcbstorage.edp_hcb_costtpy_cnsv.TIC_SCM_FEE_SERVICE_LINE_DETAIL_HSQ_VIEW` l
